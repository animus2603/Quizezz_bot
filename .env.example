# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# ID чата/группы админов (можно узнать через @userinfobot, для группы будет отрицательным)
ADMIN_CHAT_ID=123456789

# Публичный URL, где будет открываться Mini App (для локалки — ngrok/cloudflared)
WEBAPP_URL=https://your-domain.example.com/webapp/index.html

# URL FastAPI бэкенда, который будет дергать webapp (тот же домен, другой путь)
API_BASE_URL=https://your-domain.example.com/api

# Реквизиты Kaspi для оплаты
KASPI_PHONE=+7 700 000 00 00
KASPI_NAME=Иван Иванов

# База данных
DATABASE_URL=sqlite+aiosqlite:///./db/app.db
